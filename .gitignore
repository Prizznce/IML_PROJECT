# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/


# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Environment variables & secrets
.env
.env.*
!.env.example

# Models & Checkpoints (keep directory structure)
models/*
!models/.gitkeep

# Datasets (keep directory structure)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Logs (keep directory structure)
logs/*
!logs/.gitkeep

# Operating System temporary files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.tmp
*~

# IDE & Editor temporary files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
