# ==============================================================================
# VeritasLM Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your credentials:
#   copy .env.example .env

# Hugging Face User Access Token
# Required ONLY when downloading gated models (Meta Llama 3.2, Google Gemma 3).
# NOT required for the default model (Qwen 3.5 0.8B) or after weights are cached.
# Obtain a read token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Local Offline Execution Flags (enforced by default in run_app.bat & VeritasLM)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PYTHONPATH=.
